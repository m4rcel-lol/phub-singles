# pornhub.singles / phub-singles environment example
# Copy to .env and adjust values before starting:
#   cp .env.example .env
#
# All runtime configuration is read from PHS_* variables (see backend/internal/config/config.go).
# Secrets are never compiled into the binary.

# ---------------------------------------------------------------------------
# Required on first start
# ---------------------------------------------------------------------------
# Bootstrap admin account (created on first run if the DB is empty).
# Password must be at least 8 characters; it is bcrypt-hashed before storage.
# After the first start the password is only changed via the admin UI
# (or by setting PHS_ADMIN_PASSWORD_RESET=true for a single restart).
PHS_ADMIN_USERNAME=admin
PHS_ADMIN_PASSWORD=change-me-to-a-strong-password

# Set to true for a single start to force-reset the admin password from
# PHS_ADMIN_PASSWORD, then set back to false.
PHS_ADMIN_PASSWORD_RESET=false

# ---------------------------------------------------------------------------
# Server & networking
# ---------------------------------------------------------------------------
# Listen address of the HTTP server (inside the container this is overridden).
PHS_ADDR=:8080

# Canonical public origin (no trailing slash). Used for logging and CORS.
# For docker-compose local access this is set to http://localhost:25169.
PHS_PUBLIC_URL=http://localhost:8080

# Honour X-Forwarded-For / X-Real-IP. Set false when the app is exposed
# directly (as in the default docker-compose.yml).
PHS_TRUST_PROXY=true

# Set the Secure flag on the session cookie. Only disable for plain HTTP
# local development.
PHS_SECURE_COOKIE=true

# Extra origins allowed to call the API (comma-separated). Empty = same-origin only.
# PHS_CORS_ORIGINS=https://example.com,https://admin.example.com

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# SQLite database file path.
PHS_DB_PATH=./data/phs.db

# Directory for uploaded avatars.
PHS_UPLOAD_DIR=./data/uploads

# Maximum size of a single avatar upload in bytes (default 2 MiB).
PHS_MAX_UPLOAD_BYTES=2097152

# ---------------------------------------------------------------------------
# Sessions & analytics
# ---------------------------------------------------------------------------
# Lifetime of an admin session cookie (Go duration, e.g. 24h, 12h, 30m).
PHS_SESSION_TTL=24h

# How long one visitor's page view is de-duplicated (Go duration).
PHS_VIEW_WINDOW=12h

# ---------------------------------------------------------------------------
# Logging & shutdown
# ---------------------------------------------------------------------------
# Log level: debug | info | warn | error
PHS_LOG_LEVEL=info

# Log format: json | text
PHS_LOG_FORMAT=json

# Grace period for in-flight requests on shutdown (Go duration).
PHS_SHUTDOWN_TIMEOUT=15s

# ---------------------------------------------------------------------------
# Optional: Caddy / TLS (only if you use the caddy/Caddyfile)
# ---------------------------------------------------------------------------
# ACME account contact email.
# ACME_EMAIL=admin@example.com

# Site address for Caddy (e.g. localhost or your domain).
# SITE_ADDRESS=localhost
